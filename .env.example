# Required for the admin UI. Generate a long unique value; do not commit .env.
WONKEPG_ADMIN_PASSWORD=

TZ=UTC
WONKEPG_BIND_ADDRESS=127.0.0.1
WONKEPG_PORT=34500
WONKEPG_SESSION_MINUTES=480
WONKEPG_COOKIE_SECURE=false
WONKEPG_ALLOWED_FOUNDATION_ROOTS=/foundation
WONKEPG_ALLOW_PRIVATE_SOURCE_URLS=false
# Comma-separated exact hostnames for intentionally configured private feeds.
WONKEPG_ALLOWED_SOURCE_HOSTS=

# Optional public HTTPS artwork hostname and notifications.
SERVER_DOMAIN=example.com
SECURE_ASSET_ROOT=/secure-assets
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_SSL=false
